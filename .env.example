# Optional for the dry-run skeleton. Defaults are shown below.
PORT=5000
NEAR_NETWORK=testnet

# Quote source. "mock" is the safe default and makes no external calls.
# Set to "1click-dry" only when you want read-only 1Click dry quotes.
# 1Click is mainnet-only. dry:true is hardcoded on the server; no transaction,
# wallet, deposit address, or deposit/submit path exists.
QUOTE_SOURCE=mock

# Market price source for the dry-run token quantity. "mock" is the safe default
# and makes no network request. "coinbase" reads public, read-only Coinbase
# Exchange USD tickers for NEAR, BTC, and ETH. Quote targets stay NEAR-only.
# A market price is not an executable NEAR Intents quote.
PRICE_SOURCE=mock

# When PRICE_SOURCE=coinbase, "labeled-mock" (default) falls back to a clearly
# labelled local reference price if the feed fails. "off" returns 503 instead.
PRICE_FALLBACK=labeled-mock

# Cache lifetime, stale-warning threshold, and hard maximum age for a ticker's
# last trade. Values are milliseconds. The hard maximum is never lower than the
# stale threshold. Defaults: 15000, 60000, 300000.
# PRICE_TTL_MS=15000
# PRICE_STALE_MS=60000
# PRICE_MAX_AGE_MS=300000

# Required only when QUOTE_SOURCE=1click-dry. Replace the empty placeholders
# with your own public addresses. They shape the dry quote request only and do
# not connect a wallet or allow a transaction. Missing values make the API
# return a configuration error and make no 1Click request.
# ONECLICK_DRY_RECIPIENT=
# ONECLICK_DRY_REFUND_TO=

# Optional backend-only 1Click credential. It is sent as X-API-Key and is never
# returned to the browser. Leave empty to use unauthenticated quotes.
# ONECLICK_API_KEY=

# Optional legacy backend-only JWT. Sent as Authorization: Bearer. Prefer
# ONECLICK_API_KEY when both are set.
# ONECLICK_JWT=
